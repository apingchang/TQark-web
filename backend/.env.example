# TQark-web .env 範本
# ⚠️ 這是範本,實際的值在 credentials/.env(不會被 git track)
# 複製: cp credentials/.env backend/.env 然後調整路徑

# === Google OAuth ===
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# === Admin ===
ADMIN_EMAILS=your.email@gmail.com

# === JWT 簽章密鑰 ===
# 用: openssl rand -hex 32
JWT_SECRET=replace-me-with-32-byte-hex

# === File paths (Phase 1 開發環境) ===
COOKIES_PATH=/home/aping/MyProjects/TQark-web/credentials/studyark_cookies.json
DB_PATH=/home/aping/MyProjects/TQark-web/credentials/app.db
PDF_CACHE_DIR=/home/aping/MyProjects/TQark-web/credentials/pdfs
LOG_DIR=/home/aping/MyProjects/TQark-web/credentials/logs

# === Server ===
PORT=8000
ENV=development

# === Public URL ===
PUBLIC_BASE_URL=https://just4fun.myiphost.com:8443